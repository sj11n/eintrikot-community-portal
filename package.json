{
  "name": "eintrikot-community-portal",
  "private": true,
  "description": "Nur Entwicklungswerkzeuge (Formatierung). Wird nicht auf den Server eingespielt.",
  "scripts": {
    "format": "prettier --write \"wp-content/plugins/eintrikot-community-core/**/*.{php,js}\" \"wp-content/plugins/eintrikot-newsletter/**/*.{php,js}\" wp-content/themes/eintrikot-community/functions.php",
    "check": "prettier --check \"wp-content/plugins/eintrikot-community-core/**/*.{php,js}\" \"wp-content/plugins/eintrikot-newsletter/**/*.{php,js}\" wp-content/themes/eintrikot-community/functions.php"
  },
  "devDependencies": {
    "@prettier/plugin-php": "0.26.0",
    "prettier": "3.9.10"
  }
}
